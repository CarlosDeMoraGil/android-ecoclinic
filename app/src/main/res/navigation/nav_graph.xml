<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/informationFragment">

    <fragment
        android:id="@+id/informationFragment"
        android:name="com.carlosdmg.ecoclinic.feature.information.presentation.InformationFragment"
        android:label="InformationFragment"
        tools:layout="@layout/fragment_information" />

    <fragment
        android:id="@+id/appointmentFragment"
        android:name="com.carlosdmg.ecoclinic.feature.appointment.presentation.AppointmentFragment"
        android:label="AppointmentFragment"
        tools:layout="@layout/fragment_appointment" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.carlosdmg.ecoclinic.feature.user.presentation.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_log_in">

        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />

        <action
            android:id="@+id/action_loginFragment_to_userFragment"
            app:destination="@id/userFragment" />

        <argument
            android:name="isSignUp"
            app:argType="boolean"
            android:defaultValue="false" />


    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.carlosdmg.ecoclinic.feature.user.presentation.SignupFragment"
        android:label="SignupFragment"
        tools:layout="@layout/fragment_sign_up">

        <action
            android:id="@+id/action_signupFragment_to_loginFragment"
            app:destination="@id/loginFragment" />

    </fragment>


    <fragment
        android:id="@+id/userFragment"
        android:name="com.carlosdmg.ecoclinic.feature.user.presentation.UserFragment"
        android:label="UserFragment"
        tools:layout="@layout/fragment_user">

        <action
            android:id="@+id/action_userFragment_to_loginFragment"
            app:destination="@id/loginFragment"/>

    </fragment>

</navigation>