<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Commons Component -->
    <style name="AppHeadline" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_theme_onSurface_headline</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppHeadlineHeader" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_theme_onSecondaryContainer</item>
    </style>

    <style name="AppSupportingText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="AppOverlineText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="BottomRoundedCard" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">@dimen/image_m</item>
        <item name="cornerSizeBottomRight">@dimen/image_m</item>
        <item name="cornerSizeTopLeft">@dimen/ex_zero</item>
        <item name="cornerSizeTopRight">@dimen/ex_zero</item>
    </style>

    <style name="CustomEditText">
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:background">@drawable/bg_edittext_rounded</item>
        <item name="android:paddingStart">@dimen/ex_xxs</item>
        <item name="android:paddingEnd">@dimen/ex_xxs</item>
        <item name="android:textColorHint">@color/md_theme_outlineVariant</item>
        <item name="android:textSize">@dimen/text_xs</item>
    </style>

    <style name="AppButton.SignUp" parent="Widget.Material3.Button">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">@dimen/image_m</item>
        <item name="backgroundTint">@color/md_theme_primaryContainer</item>
        <item name="android:insetTop">@dimen/ex_zero</item>
        <item name="android:insetBottom">@dimen/ex_zero</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="strokeColor">@color/md_theme_primaryContainer_v2</item>
        <item name="strokeWidth">@dimen/ex_mininum</item>
    </style>

</resources>