<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/appt_vw_cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/md_theme_primaryContainer_v3"
        app:cardCornerRadius="@dimen/space_m"
        app:cardElevation="@dimen/space_xs"
        app:layout_constraintBottom_toTopOf="@id/appt_vw_divider"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_m">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/appt_vw_header"
                style="@style/AppHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appt_vw_headline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/appt_vw_type"
                style="@style/AppSupportingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_m"
                android:text="@string/appt_vw_type"
                app:layout_constraintBottom_toTopOf="@id/appt_vw_type"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appt_vw_header" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/appt_vw_timestamp"
                style="@style/AppSupportingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_m"
                android:text="@string/appt_vw_timestamp"
                app:layout_constraintBottom_toTopOf="@id/appt_vw_details"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appt_vw_type" />


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/appt_vw_details"
                style="@style/AppSupportingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appt_vw_details"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appt_vw_timestamp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/appt_vw_type_data"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_s"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="@id/appt_vw_type"
                app:layout_constraintStart_toEndOf="@id/appt_vw_type"
                app:layout_constraintTop_toTopOf="@id/appt_vw_type" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/appt_vw_timestamp_data"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_s"
                app:layout_constraintBottom_toBottomOf="@id/appt_vw_timestamp"
                app:layout_constraintStart_toEndOf="@id/appt_vw_timestamp"
                app:layout_constraintTop_toTopOf="@id/appt_vw_timestamp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/appt_vw_details_data"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                app:layout_constraintBottom_toBottomOf="@id/appt_vw_details"
                app:layout_constraintStart_toEndOf="@id/appt_vw_details" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/in_fr_phone_button"
                android:layout_width="80dp"
                android:layout_height="@dimen/image_s"
                android:backgroundTint="@color/md_theme_primaryContainer"
                android:insetTop="@dimen/ex_zero"
                android:insetBottom="@dimen/ex_zero"
                android:text="@string/appt_vw_cancel"
                android:textSize="@dimen/ex_xxs"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onSurface"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                app:strokeColor="@color/md_theme_primaryContainer_v2"
                app:strokeWidth="@dimen/ex_mininum" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/appt_vw_edit"
                android:layout_width="@dimen/image_s"
                android:layout_height="@dimen/image_s"
                android:layout_marginBottom="@dimen/space_m"
                android:backgroundTint="@color/md_theme_primaryContainer"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_edit_outlined"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="@dimen/image_xs"
                app:iconTint="@color/md_theme_onSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                app:strokeColor="@color/md_theme_primaryContainer_v2"
                app:strokeWidth="@dimen/ex_mininum" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appt_vw_remind"
                android:layout_width="@dimen/image_s"
                android:layout_height="@dimen/image_s"
                android:layout_marginEnd="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_m"
                android:backgroundTint="@color/md_theme_primaryContainer"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_clock"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="@dimen/image_xs"
                app:iconTint="@color/md_theme_onSurface"
                app:layout_constraintEnd_toStartOf="@id/appt_vw_edit"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                app:strokeColor="@color/md_theme_primaryContainer_v2"
                app:strokeWidth="@dimen/ex_mininum" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/appt_vw_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ex_mininum"
        android:layout_marginVertical="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appt_vw_cardview" />


</androidx.constraintlayout.widget.ConstraintLayout>

